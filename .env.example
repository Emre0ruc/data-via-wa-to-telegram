# Telegram bot token from @BotFather (format: 123456789:ABC-...)
TELEGRAM_BOT_TOKEN=
# Numeric chat ID the bot is allowed to send to (your own chat with the bot)
TELEGRAM_CHAT_ID=
# Session, database and temporary media live here
DATA_DIR=./data
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Messages starting with this prefix are never relayed
PRIVATE_PREFIX=#gizli
